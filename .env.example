# ── Issue Tracker — Production Environment Variables ──────────────────────────
# Copy this file to .env and fill in values before running docker-compose.yml

# ── Container Images (pre-built and pushed to ECR/registry) ──────────────────
IMAGE_AUTH=your-registry/auth-service:latest
IMAGE_CORE=your-registry/core-service:latest
IMAGE_NOTIFICATION=your-registry/notification-service:latest
IMAGE_GATEWAY=your-registry/gateway:latest
IMAGE_CLIENT=your-registry/client:latest

# ── Auth Database ─────────────────────────────────────────────────────────────
AUTH_DB_USER=auth_user
AUTH_DB_PASS=CHANGE_ME
AUTH_DB_NAME=auth_db

# ── Core Database ─────────────────────────────────────────────────────────────
CORE_DB_USER=core_user
CORE_DB_PASS=CHANGE_ME
CORE_DB_NAME=core_db

# ── Notifications Database ────────────────────────────────────────────────────
NOTIF_DB_USER=notifications_user
NOTIF_DB_PASS=CHANGE_ME
NOTIF_DB_NAME=notifications_db

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=rabbit_user
RABBITMQ_PASS=CHANGE_ME

# ── RSA Keys (PEM format, used for JWT signing/verification) ─────────────────
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# ── Internal API Key (shared secret between auth ↔ core gRPC) ────────────────
INTERNAL_API_KEY=CHANGE_ME

# ── SMTP (email notifications) ───────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@issuetracker.local
SMTP_USE_TLS=true

# ── Frontend URL (used in notification email links) ──────────────────────────
FRONTEND_URL=https://your-domain.com

# ── Client build arg (baked into Next.js bundle at image build time) ─────────
# Pass as: docker build --build-arg NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO